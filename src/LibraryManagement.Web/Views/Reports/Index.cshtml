@model LibraryManagement.Web.ViewModels.ReportViewModel
@{var r=Model.Result;var f=r.Filter;var route=new Dictionary<string,string>{{"Report",f.Report},{"FromDate",f.FromDate?.ToString("yyyy-MM-dd")??""},{"ToDate",f.ToDate?.ToString("yyyy-MM-dd")??""},{"MemberId",f.MemberId?.ToString()??""},{"BookId",f.BookId?.ToString()??""},{"Status",f.Status}};ViewData["Title"]="Reports";}
<div class="page-heading"><div><p class="eyebrow">LIBRARY REPORTING</p><h1>@r.Definition.Title</h1><p class="text-secondary">Filter, review and export library records.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Export" asp-all-route-data="route" asp-route-format="excel" class="btn btn-primary">Export Excel</a><a asp-action="Export" asp-all-route-data="route" asp-route-format="pdf" class="btn btn-outline-primary">Export PDF</a></div></div>
<form method="get" class="surface p-3 mb-4">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-3">
<div class="col-md-6"><label for="Report" class="form-label">Report</label><select id="Report" name="Report" class="form-select">@foreach(var d in ReportCatalog.All){<option value="@d.Key" data-statuses="@string.Join(",",d.Statuses)" selected="@(f.Report==d.Key?"selected":null)">@d.Title</option>}</select></div>
<div class="col-md-6"><label for="Status" class="form-label">Status</label><select id="Status" name="Status" class="form-select">@foreach(var status in r.Definition.Statuses){<option value="@status" selected="@(f.Status==status?"selected":null)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(status.Replace("-"," "))</option>}</select></div>
<div class="col-md-6"><label for="FromDate" class="form-label">From date</label><input type="date" id="FromDate" name="FromDate" value="@f.FromDate?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" class="form-control"/></div>
<div class="col-md-6"><label for="ToDate" class="form-label">To date</label><input type="date" id="ToDate" name="ToDate" value="@f.ToDate?.ToString("yyyy-MM-dd")" min="1900-01-01" max="9998-12-31" class="form-control"/></div>
<div class="col-md-6 lookup" data-url="@Url.Action("Lookup","Books",new { includeArchived=true })"><label for="report-book" class="form-label">Book</label><input id="report-book" class="form-control lookup-input" value="@Model.BookLabel" placeholder="Search title or ISBN" autocomplete="off"/><input type="hidden" name="BookId" class="lookup-id" value="@f.BookId" data-optional="true"/><div class="lookup-results list-group" aria-live="polite"></div><p class="lookup-selection form-text">@(Model.BookLabel??"All books")</p></div>
<div class="col-md-6 lookup" data-url="@Url.Action("Lookup","Members",new { includeArchived=true })"><label for="report-member" class="form-label">Member</label><input id="report-member" class="form-control lookup-input" value="@Model.MemberLabel" placeholder="Search member name or ID" autocomplete="off"/><input type="hidden" name="MemberId" class="lookup-id" value="@f.MemberId" data-optional="true"/><div class="lookup-results list-group" aria-live="polite"></div><p class="lookup-selection form-text">@(Model.MemberLabel??"All members")</p></div>
</div><p class="form-text">Date filters use <strong>@r.Definition.DateBasis.ToLowerInvariant()</strong> in UTC; both endpoints are included. @r.Definition.Notes</p>
<button class="btn btn-dark">Run report</button><a asp-action="Index" asp-route-report="@f.Report" class="btn btn-outline-secondary">Clear filters</a>
</form>
<div class="row g-3 mb-3"><div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Matching rows</span><strong class="fs-3">@r.Totals.TotalRecords.ToString("N0")</strong></div></div>
@if(f.Report=="stock"){<div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Book quantity</span><strong class="fs-3">@r.Totals.TotalCopies.ToString("N0")</strong></div></div><div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Available copies</span><strong class="fs-3">@r.Totals.AvailableCopies.ToString("N0")</strong></div></div>}
else if(f.Report=="collections"){<div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Fine collected</span><strong class="fs-3">₹@r.Totals.CollectedAmount.ToString("N2")</strong></div></div>}
else{<div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Issues</span><strong class="fs-3">@r.Totals.IssuedCount.ToString("N0")</strong></div></div><div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Returns</span><strong class="fs-3">@r.Totals.ReturnedCount.ToString("N0")</strong></div></div>@if(f.Report=="monthly"||f.Report=="members"){<div class="col-sm-6 col-lg"><div class="card p-3"><span class="text-secondary">Fine collected</span><strong class="fs-3">₹@r.Totals.CollectedAmount.ToString("N2")</strong></div></div>}}
</div>
<p class="form-text">Totals include all matching pages. Excel/PDF exports contain all matching rows up to 5,000; use filters for larger results. Generated @r.Totals.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC.</p>
<div class="surface table-responsive"><table class="table align-middle report-table"><thead><tr>@foreach(var c in r.Definition.Columns){<th>@c.Heading</th>}</tr></thead><tbody>@foreach(var row in r.Rows){<tr>@foreach(var cell in row){<td class="@(cell.Type is ReportValueType.Number or ReportValueType.Money?"text-end":"")">@cell.Text</td>}</tr>}@if(r.Rows.Count==0){<tr><td colspan="@r.Definition.Columns.Count" class="empty-state">No records match these filters.</td></tr>}</tbody></table></div>
<nav class="pager" aria-label="Report pagination"><span>Page @f.Page of @r.TotalPages</span><div class="d-flex gap-2">@if(f.Page>1){<a asp-all-route-data="route" asp-route-page="@(f.Page-1)" class="btn btn-outline-secondary">Previous</a>}@if(f.Page<r.TotalPages){<a asp-all-route-data="route" asp-route-page="@(f.Page+1)" class="btn btn-outline-secondary">Next</a>}</div></nav>
@section Scripts{<script src="~/js/reports.js" asp-append-version="true"></script>}
