@model LibraryManagement.Web.ViewModels.UserListViewModel
@{ViewData["Title"]="User management";var f=Model.Filter;var p=Model.Users;var route=new Dictionary<string,string>{{"Search",f.Search??""},{"Role",f.Role},{"Status",f.Status}};}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>User management</h1><p class="text-secondary">Manage account details, roles and access.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Activity" class="btn btn-outline-secondary">User activity logs</a><a asp-action="Create" class="btn btn-primary">+ Create user</a></div></div>
<form method="get" class="surface p-3 mb-4"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3 align-items-end"><div class="col-lg-5"><label for="Search" class="form-label">Search name or email</label><input id="Search" name="Search" value="@f.Search" maxlength="200" class="form-control"/></div><div class="col-lg-3"><label for="Role" class="form-label">Role</label><select id="Role" name="Role" class="form-select">@foreach(var role in new[]{"all",Roles.Admin,Roles.Librarian,Roles.Member}){<option value="@role" selected="@(f.Role==role?"selected":null)">@role</option>}</select></div><div class="col-lg-3"><label for="Status" class="form-label">Access status</label><select id="Status" name="Status" class="form-select">@foreach(var status in new[]{"all","active","inactive","locked"}){<option value="@status" selected="@(f.Status==status?"selected":null)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(status)</option>}</select></div><div class="col-lg-1"><button class="btn btn-dark">Filter</button></div></div><a asp-action="Index" class="small d-inline-block mt-2">Clear filters</a></form>
<p class="result-count">@p.Total matching accounts. Active accounts may be temporarily locked after failed sign-in attempts.</p>
<div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Name / email</th><th>Role / membership</th><th>Access</th><th>Actions</th></tr></thead><tbody>
@foreach(var user in p.Items){var locked=user.IsActive&&user.LockoutEnd>LibraryManagement.Domain.Rules.IndiaTime.Now;<tr><td><strong>@user.FullName</strong><div class="small text-secondary">@user.Email</div></td><td>@user.Role @if(user.MemberId.HasValue){<div class="small text-secondary">Member record #@user.MemberId</div>}</td><td><span class="status-pill @(user.IsActive&&!locked?"status-good":"status-warning")">@(!user.IsActive?"Inactive":locked?"Temporarily locked":"Active")</span></td><td><div class="d-flex flex-wrap gap-2"><a asp-controller="UserAccess" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Page rights</a><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit / assign role</a><a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Reset password</a><a asp-action="Activity" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-secondary">Activity</a><a asp-action="Access" asp-route-id="@user.Id" asp-route-enabled="@(!user.IsActive?"true":"false")" class="btn btn-sm btn-outline-secondary">@(user.IsActive?"Deactivate":"Activate")</a>@if(locked){<a asp-action="Access" asp-route-id="@user.Id" asp-route-enabled="true" class="btn btn-sm btn-outline-secondary">Unlock</a>}</div></td></tr>}
@if(p.Items.Count==0){<tr><td colspan="4" class="empty-state">No users match these filters.</td></tr>}</tbody></table></div>
<nav class="pager" aria-label="User pagination"><span>Page @p.Page of @p.TotalPages</span><div class="d-flex gap-2">@if(p.Page>1){<a asp-all-route-data="route" asp-route-page="@(p.Page-1)" class="btn btn-outline-secondary">Previous</a>}@if(p.Page<p.TotalPages){<a asp-all-route-data="route" asp-route-page="@(p.Page+1)" class="btn btn-outline-secondary">Next</a>}</div></nav>
