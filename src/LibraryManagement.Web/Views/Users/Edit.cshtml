@model EditUserModel
@{ViewData["Title"]="Edit user";}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Edit user</h1><p class="text-secondary">Update account details and assign a role.</p></div><a asp-action="Index" class="btn btn-outline-secondary">User management</a></div>
<form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="surface form-surface"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><input asp-for="Revision" type="hidden"/>
<label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3"/><span asp-validation-for="FullName" class="text-danger"></span>
<label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control mb-3"/><span asp-validation-for="Email" class="text-danger"></span>
<label asp-for="Role" class="form-label">Role</label><select asp-for="Role" class="form-select mb-3">@foreach(var role in new[]{Roles.Admin,Roles.Librarian,Roles.Member}){<option value="@role">@role</option>}</select>
<div id="user-member-fields" class="lookup mb-3" data-url="@Url.Action("Lookup","Members",new { includeArchived=true })"><label for="user-member-search" class="form-label">Linked member</label><input id="user-member-search" class="lookup-input form-control" value="@ViewBag.MemberLabel" placeholder="Search member ID or email" autocomplete="off"/><input asp-for="MemberId" type="hidden" class="lookup-id" data-optional="true"/><div class="lookup-results list-group" aria-live="polite"></div><p class="lookup-selection form-text">@(ViewBag.MemberLabel??"Choose a membership with matching email. Deleted memberships cannot be linked.")</p><span asp-validation-for="MemberId" class="text-danger"></span></div>
<p class="form-text">Changes sign out existing sessions. You cannot change your own role. At least one active Admin must remain. Membership history is retained when a Member account becomes a staff account.</p>
<div class="form-actions"><button class="btn btn-primary">Save user</button><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Reload account</a><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/users.js" asp-append-version="true"></script>}
