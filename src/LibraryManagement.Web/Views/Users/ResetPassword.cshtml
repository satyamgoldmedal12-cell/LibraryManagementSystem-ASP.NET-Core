@model ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<p class="eyebrow">ADMINISTRATION</p>
<h1>Reset account password</h1>
@if(ViewBag.UserLabel is string label){<p><strong>@label</strong></p>}
<p class="text-secondary mb-4">Share the new password with the account holder securely.</p>

<form method="post" asp-action="ResetPassword" class="surface form-surface">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <label asp-for="NewPassword" class="form-label"></label>
    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
    <p class="form-text">12+ characters with uppercase, lowercase, a number, and a symbol.</p>

    <div class="form-actions">
        <button class="btn btn-primary">Reset password</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
