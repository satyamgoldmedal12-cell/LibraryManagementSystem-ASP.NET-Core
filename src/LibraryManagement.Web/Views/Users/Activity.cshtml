@model LibraryManagement.Web.ViewModels.UserActivityViewModel
@{ViewData["Title"]="User activity logs";var f=Model.Filter;var p=Model.Activity;var route=new Dictionary<string,string>{{"UserId",f.UserId??""},{"Action",f.Action??""},{"FromDate",f.FromDate?.ToString("yyyy-MM-dd")??""},{"ToDate",f.ToDate?.ToString("yyyy-MM-dd")??""}};}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION · AUDIT</p><h1>User activity logs</h1><p class="text-secondary">Sign-ins, sign-outs, account changes and library operations.</p></div><a asp-action="Index" class="btn btn-outline-secondary">User management</a></div>
<form method="get" class="surface p-3 mb-4"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="row g-3">
<div class="col-md-6 lookup" data-url="@Url.Action("Lookup")"><label for="activity-user" class="form-label">Acting or affected user</label><input id="activity-user" value="@Model.UserLabel" class="lookup-input form-control" placeholder="Search user name or email" autocomplete="off"/><input type="hidden" name="UserId" value="@f.UserId" class="lookup-id" data-optional="true"/><div class="lookup-results list-group" aria-live="polite"></div><p class="lookup-selection form-text">@(Model.UserLabel??"All users")</p></div>
<div class="col-md-6"><label for="Action" class="form-label">Action</label><select id="Action" name="Action" class="form-select"><option value="">All actions</option>@foreach(var action in new[]{"Signed in","Signed out","User created","User edited","User enabled","User disabled","Password reset by admin","Password changed","Password reset","Book issued","Book returned","Fine paid"}){<option value="@action" selected="@(f.Action==action?"selected":null)">@action</option>}</select></div>
<div class="col-md-6"><label for="FromDate" class="form-label">From date</label><input type="date" id="FromDate" name="FromDate" value="@f.FromDate?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-6"><label for="ToDate" class="form-label">To date</label><input type="date" id="ToDate" name="ToDate" value="@f.ToDate?.ToString("yyyy-MM-dd")" class="form-control"/></div></div><p class="form-text">UTC dates, both endpoints included. A user filter includes actions performed by that user and account changes affecting them. Passwords, tokens and password hashes are excluded.</p><button class="btn btn-dark">Filter activity</button><a asp-action="Activity" class="btn btn-outline-secondary">Clear</a></form>
<p class="result-count">@p.Total activity records</p><div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Date (UTC)</th><th>Performed by</th><th>Action</th><th>Affected user / record</th></tr></thead><tbody>@foreach(var e in p.Items){<tr><td>@e.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@e.ActorName</td><td>@e.Action</td><td>@(e.SubjectName??e.EntityId)</td></tr>}@if(p.Items.Count==0){<tr><td colspan="4" class="empty-state">No activity matches these filters.</td></tr>}</tbody></table></div>
<nav class="pager" aria-label="Activity pagination"><span>Page @p.Page of @p.TotalPages</span><div class="d-flex gap-2">@if(p.Page>1){<a asp-all-route-data="route" asp-route-page="@(p.Page-1)" class="btn btn-outline-secondary">Previous</a>}@if(p.Page<p.TotalPages){<a asp-all-route-data="route" asp-route-page="@(p.Page+1)" class="btn btn-outline-secondary">Next</a>}</div></nav>
