@model CreateUserModel
@{ ViewData["Title"] = "Create account"; }
<p class="eyebrow">ADMINISTRATION</p>
<h1>Create account</h1>
<p class="text-secondary mb-4">Member accounts must match an existing membership email.</p>

<form method="post" asp-action="Create" class="surface form-surface">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

    <div class="mb-4">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-4">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <p class="form-text">12+ characters with uppercase, lowercase, a number, and a symbol.</p>
    </div>

    <div class="mb-4">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            <option>Librarian</option>
            <option>Member</option>
            <option>Admin</option>
        </select>
    </div>

    <div id="user-member-fields" class="mb-4 lookup" data-url="@Url.Action("Lookup","Members",new { includeArchived=true })">
        <label for="user-member-search" class="form-label">Linked member</label>
        <input id="user-member-search" class="form-control lookup-input" value="@ViewBag.MemberLabel" placeholder="Search member ID, name or email" autocomplete="off"/>
        <input asp-for="MemberId" type="hidden" class="lookup-id" data-optional="true"/>
        <div class="lookup-results list-group" aria-live="polite"></div><p class="lookup-selection form-text">@(ViewBag.MemberLabel??"Choose a non-deleted member with matching email. Leave empty for staff.")</p>
    </div>

    <button class="btn btn-primary">Create account</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /><script src="~/js/users.js" asp-append-version="true"></script>
}
