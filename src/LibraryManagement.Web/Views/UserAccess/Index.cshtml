@model UserListViewModel
@{ViewData["Title"]="User access";var f=Model.Filter;var p=Model.Users;}
<div class="page-heading"><div><p class="eyebrow">ACCESS ADMINISTRATION</p><h1>User access</h1><p class="text-secondary">Choose a user to assign page and operation rights.</p></div><a asp-controller="ModulePaths" asp-action="Index" class="btn btn-outline-primary">Module paths</a></div>
<form method="get" class="filter-bar"><div asp-validation-summary="All" class="text-danger"></div><label class="visually-hidden" for="Search">Search users</label><input id="Search" name="Search" value="@f.Search" maxlength="200" class="form-control" placeholder="Search name or email"/><select name="Role" class="form-select filter-select" aria-label="Role">@foreach(var role in new[]{"all",Roles.Admin,Roles.Librarian,Roles.Member}){<option value="@role" selected="@(f.Role==role)">@role</option>}</select><button class="btn btn-dark">Search</button></form>
<div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Page rights</th></tr></thead><tbody>@foreach(var user in p.Items){<tr><td><strong>@user.FullName</strong><div class="small text-secondary">@user.Email</div></td><td>@user.Role</td><td>@(user.IsActive?"Active":"Inactive")</td><td><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">@(user.Role==Roles.Admin?"View administrator access":"Assign rights")</a></td></tr>}@if(p.Items.Count==0){<tr><td colspan="4">No matching users.</td></tr>}</tbody></table></div>
<nav class="pager" aria-label="User access pagination"><span>Page @p.Page of @p.TotalPages · @p.Total users</span><div class="d-flex gap-2">@if(p.Page>1){<a asp-action="Index" asp-route-search="@f.Search" asp-route-role="@f.Role" asp-route-page="@(p.Page-1)" class="btn btn-outline-secondary">Previous</a>}@if(p.Page<p.TotalPages){<a asp-action="Index" asp-route-search="@f.Search" asp-route-role="@f.Role" asp-route-page="@(p.Page+1)" class="btn btn-outline-secondary">Next</a>}</div></nav>
