@model PagedResult<Loan>
@{ViewData["Title"]="Book issue history";}
<div class="page-heading"><div><p class="eyebrow">BOOK ISSUE MANAGEMENT</p><h1>Book issue history</h1><p class="text-secondary">Current and completed issues. Timestamps use UTC.</p></div><a asp-action="Issue" class="btn btn-primary">+ Issue a book</a></div>
<form method="get" class="filter-bar"><label for="search" class="visually-hidden">Search issue history</label><input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Search book or member" maxlength="200"/><label for="status" class="visually-hidden">Issue status</label><select id="status" name="status" class="form-select filter-select">@foreach(var status in new[]{"all","active","overdue","returned"}){<option value="@status" selected="@(Model.Status==status)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(status)</option>}</select><button class="btn btn-dark">Filter</button><a asp-action="History" class="btn btn-outline-secondary">Clear</a></form>
<p class="result-count">@Model.Total issue records</p><div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Issue ID</th><th>Book</th><th>Member</th><th>Issue date</th><th>Due date</th><th>Status</th><th>Receipt</th></tr></thead><tbody>@foreach(var loan in Model.Items){<tr><td>#@loan.Id</td><td>@loan.Title</td><td>@loan.MemberName<div class="small text-secondary">@loan.MemberNumber</div></td><td>@loan.IssuedAt.ToString("dd MMM yyyy")<div class="small text-secondary">@loan.IssuedAt.ToString("HH:mm:ss") UTC</div></td><td>@loan.DueDate.ToString("dd MMM yyyy")</td><td>@(loan.ReturnedAt.HasValue?"Returned":loan.IsOverdue?"Overdue":"On loan")</td><td><a asp-action="Receipt" asp-route-id="@loan.Id">View receipt</a></td></tr>}@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">No issue records match this view.</td></tr>}</tbody></table></div>
<nav class="pager" aria-label="Issue history pagination"><span>Page @Model.Page of @Model.TotalPages</span><div class="d-flex gap-2">@if(Model.Page>1){<a asp-action="History" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="btn btn-outline-secondary">Previous</a>}@if(Model.Page<Model.TotalPages){<a asp-action="History" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="btn btn-outline-secondary">Next</a>}</div></nav>
