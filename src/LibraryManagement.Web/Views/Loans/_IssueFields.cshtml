@model IssueLoan
@{var assessment=((LibraryManagement.Web.ViewModels.IssueBookViewModel)ViewData["IssuePage"]!).Assessment;}
<div class="mb-4 lookup" data-url="@Url.Action("Lookup","Books")"><label for="book-search" class="form-label">Select book</label><input id="book-search" class="form-control lookup-input" autocomplete="off" value="@(assessment.Context.BookId.HasValue?$"{assessment.Context.BookTitle} — {assessment.Context.ISBN}":"")" placeholder="Search title, author, publisher, category, or ISBN" aria-describedby="book-selection"/><input asp-for="BookId" type="hidden" class="lookup-id"/><div class="lookup-results list-group" aria-live="polite"></div><p id="book-selection" class="lookup-selection form-text">@(assessment.Context.BookId.HasValue?$"Selected: {assessment.Context.BookTitle}":"Choose a book from the results.")</p><span asp-validation-for="BookId" class="text-danger"></span></div>
<div class="mb-4 lookup" data-url="@Url.Action("Lookup","Members")"><label for="member-search" class="form-label">Select member</label><input id="member-search" class="form-control lookup-input" autocomplete="off" value="@(assessment.Context.MemberId.HasValue?$"{assessment.Context.MemberNumber} — {assessment.Context.MemberName}":"")" placeholder="Search member name, ID, email, mobile, or address" aria-describedby="member-selection"/><input asp-for="MemberId" type="hidden" class="lookup-id"/><div class="lookup-results list-group" aria-live="polite"></div><p id="member-selection" class="lookup-selection form-text">@(assessment.Context.MemberId.HasValue?$"Selected: {assessment.Context.MemberName}":"Choose an active member from the results.")</p><span asp-validation-for="MemberId" class="text-danger"></span></div>
<label asp-for="DueDate" class="form-label">Due date</label><input asp-for="DueDate" type="date" min="@assessment.MinimumDueDate.ToString("yyyy-MM-dd")" max="@assessment.MaximumDueDate.ToString("yyyy-MM-dd")" required class="form-control"/><span asp-validation-for="DueDate" class="text-danger"></span>
