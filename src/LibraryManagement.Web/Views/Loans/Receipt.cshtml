@model IssueReceipt
@{ViewData["Title"]="Issue receipt";var staff=User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Librarian);}
<div class="page-heading"><div><p class="eyebrow">ISSUE #@Model.Id</p><h1>Issue receipt</h1><p class="text-secondary">A permanent record of this checkout.</p></div><a asp-action="@(staff?"History":"Index")" class="btn btn-outline-secondary">@(staff?"Issue history":"My borrowing")</a></div>
<div class="surface p-4"><span class="status-pill @(Model.ReturnedAt.HasValue?"status-good":Model.DueDate.Date<LibraryManagement.Domain.Rules.IndiaTime.Today?"status-warning":"status-good")">@(Model.ReturnedAt.HasValue?"Returned":Model.DueDate.Date<LibraryManagement.Domain.Rules.IndiaTime.Today?"Overdue":"On loan")</span><dl class="issue-facts mt-3"><dt>Issue ID</dt><dd>@Model.Id</dd><dt>Book</dt><dd>@Model.BookTitle</dd><dt>ISBN</dt><dd>@Model.ISBN</dd><dt>Member</dt><dd>@Model.MemberName · @Model.MemberNumber</dd><dt>Issue date / time</dt><dd><time datetime="@Model.IssuedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">@Model.IssuedAt.ToString("dd MMM yyyy, HH:mm:ss") UTC</time></dd><dt>Due date</dt><dd>@Model.DueDate.ToString("dd MMM yyyy")</dd><dt>Issued by</dt><dd>@Model.IssuedByName</dd><dt>Fine per late day</dt><dd>₹@Model.DailyFine.ToString("N2")</dd>@if(Model.ReturnedAt.HasValue){<dt>Returned</dt><dd>@Model.ReturnedAt.Value.ToString("dd MMM yyyy, HH:mm:ss") UTC</dd>}</dl>@if(staff){<div class="d-flex gap-2 flex-wrap"><a asp-action="Issue" class="btn btn-primary">Issue another book</a>@if(Model.ReturnedAt.HasValue){<a asp-controller="Returns" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Return receipt</a>}else{<a asp-controller="Returns" asp-action="Confirm" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Return this book</a>}</div>}</div>
