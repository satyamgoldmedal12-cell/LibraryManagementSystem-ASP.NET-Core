@model ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="login-panel">
    <p class="eyebrow">ACCOUNT RECOVERY</p>
    <h1>Let's get you back in.</h1>
    <p class="text-secondary mb-4">Enter your account email to request a password reset link.</p>
    <form method="post" asp-action="ForgotPassword" class="surface form-surface">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button class="btn btn-primary w-100">Send reset link →</button>
        <p class="text-center small mt-4 mb-0"><a asp-action="Login">Back to sign in</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
