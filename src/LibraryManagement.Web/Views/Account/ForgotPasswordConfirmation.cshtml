@{ ViewData["Title"] = "Reset link requested"; }
<div class="login-panel">
    <p class="eyebrow">ACCOUNT RECOVERY</p>
    <h1>Check your inbox.</h1>

    <div class="surface form-surface">
        <p>If an eligible account matches that email, a password reset link will be sent. Check your spam folder too.</p>
        <p class="text-secondary">The link expires after 30 minutes. If you still need help, contact your library administrator.</p>
        <a asp-action="Login" class="btn btn-primary">Back to sign in</a>
    </div>
</div>
