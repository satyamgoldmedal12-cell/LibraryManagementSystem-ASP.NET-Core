@model PublicResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }
<div class="login-panel">
    <p class="eyebrow">ACCOUNT RECOVERY</p>
    <h1>A fresh start.</h1>
    <p class="text-secondary mb-4">Choose a new password for your account.</p>

    <form method="post" asp-action="ResetPassword" class="surface form-surface">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <input asp-for="UserId" type="hidden" />
        <input asp-for="Code" type="hidden" />

        <div class="mb-4">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
            <p class="form-text">Use 12–128 characters with uppercase, lowercase, a number and a symbol.</p>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button class="btn btn-primary w-100">Reset password</button>
        <p class="text-center small mt-4 mb-0"><a asp-action="ForgotPassword">Request a new reset link</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
